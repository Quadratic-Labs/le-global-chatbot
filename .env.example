# L&E Global Chatbot - Environment configuration example
#
# Copy this file to your environment configuration location and replace
# all placeholder secrets before starting the services.
#
# Never commit real passwords, API keys or production secrets.

# ----------------------------------------------------------------------
# OpenSearch
# ----------------------------------------------------------------------

# Required. OpenSearch / Dashboards Docker image version.
OPENSEARCH_VERSION=3.7.0

# Required. Administrator password used by OpenSearch and the backend.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. OpenSearch Dashboards service credentials.
# Defaults used by Docker Compose are shown below.
OPENSEARCH_DASHBOARDS_USERNAME=kibanaserver
OPENSEARCH_DASHBOARDS_PASSWORD=kibanaserver


# ----------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------

# Required. Password protecting the Redis instance.
REDIS_PASSWORD=replace-with-a-strong-password


# ----------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------

# Optional. Application environment.
# Docker Compose default: production.
APP_ENV=production

# Optional. Application logging level.
# Docker Compose default: INFO.
LOG_LEVEL=INFO

# Optional. Maximum uploaded DOCX size in bytes.
# Default: 26214400 bytes (25 MB).
DOCUMENT_UPLOAD_MAX_BYTES=26214400


# ----------------------------------------------------------------------
# OpenAI
# ----------------------------------------------------------------------

# Required for chatbot answer generation.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional. OpenAI model used by the chatbot.
# Default: gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Optional. OpenAI request timeout in seconds.
# Default: 60.
OPENAI_TIMEOUT_SECONDS=60

# Optional. Reasoning effort used for answer generation.
# Default: low.
OPENAI_ANSWER_REASONING_EFFORT=low

# Optional. Maximum output tokens for answer generation.
# Default: 2000.
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=2000

# Optional. Reasoning effort used for OpenAI reranking.
# Default: low.
OPENAI_RERANK_REASONING_EFFORT=low

# Optional. Maximum output tokens for OpenAI reranking.
# Default: 500.
OPENAI_RERANK_MAX_OUTPUT_TOKENS=500


# ----------------------------------------------------------------------
# RAG / Retrieval
# ----------------------------------------------------------------------

# Optional. Maximum combined context size supplied to generation.
# Default: 16000 characters.
RAG_MAX_CONTEXT_CHARACTERS=16000

# Optional. Maximum characters retained from an individual source.
# Default: 4000 characters.
RAG_MAX_SOURCE_CHARACTERS=4000

# Optional. Enables the reranking stage.
# Default: false.
RERANK_ENABLED=false

# Optional. Candidate-pool multiplier used when reranking is enabled.
# Default: 3.
RERANK_POOL_MULTIPLIER=3


# ----------------------------------------------------------------------
# API / Security
# ----------------------------------------------------------------------

# Required for production. Key used to authenticate public API access.
API_ACCESS_KEY=replace-with-a-strong-random-key

# Required for production. Key used to authenticate administration API access.
ADMIN_API_KEY=replace-with-a-different-strong-random-key

# Optional. Comma-separated list of allowed CORS origins.
# Empty by default.
CORS_ALLOWED_ORIGINS=


# ----------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------

# Optional. Maximum requests allowed during one rate-limit window.
# Default: 60.
RATE_LIMIT_REQUESTS=60

# Optional. Rate-limit window duration in seconds.
# Default: 60.
RATE_LIMIT_WINDOW_SECONDS=60
